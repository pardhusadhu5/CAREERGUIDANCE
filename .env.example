# Copy this file to .env.local and fill in your Gmail SMTP credentials

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=your-gmail-username@gmail.com
EMAIL_SMTP_PASS=your-app-password-or-smtp-password
EMAIL_FROM="Career Simulator <your-gmail-username@gmail.com>"
